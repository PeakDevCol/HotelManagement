rules_version = '2';

// Firestore security rules (PRD, section 8 and S3). A person publishes them; nothing here deploys itself.
// Anything without a match below is denied. Each milestone adds the rules of its own collections.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/Users/$(request.auth.uid);
    }

    // RF-AUTH-07: an account created outside the app has no profile, so it reads and writes nothing.
    // Spark has no custom claims, so the role comes from the profile. Each check costs one read.
    function isActiveEmployee() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    function isAdmin() {
      return isActiveEmployee() && get(profilePath()).data.type == 'admin';
    }

    function isValidProfile(profile) {
      return profile.keys().hasAll(['fullName', 'email', 'type', 'area', 'active'])
        && profile.keys().hasOnly(['fullName', 'email', 'type', 'area', 'active', 'createdAt', 'createdBy'])
        && profile.fullName is string
        && profile.email is string
        && profile.type in ['basic', 'reception', 'admin']
        && profile.area in ['service', 'reception', 'housekeeping', 'maintenance', 'management']
        && profile.active is bool;
    }

    match /Users/{userId} {
      // Everyone reads their own profile, even when inactive: the app needs it to explain why it denies access.
      allow get: if signedIn() && (request.auth.uid == userId || isActiveEmployee());
      allow list: if isActiveEmployee();
      // RF-EMP-04: an administrator creates the profile of a new employee, signing it with their
      // own id and the server date. The allowed keys leave no room for password fields.
      allow create: if isAdmin()
        && isValidProfile(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // RF-EMP-02, RF-EMP-03 and RF-EMP-05: an administrator changes the name, the role, the area
      // and whether an employee is active. The email and who created the profile never change.
      // Nobody changes their own role or deactivates themselves: the last administrator can only
      // be edited by themselves, so the hotel never runs out of administrators.
      function keepsItsOrigin() {
        return request.resource.data.email == resource.data.email
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      }

      function keepsOwnAccess() {
        return request.auth.uid != userId
          || (request.resource.data.type == resource.data.type && request.resource.data.active == resource.data.active);
      }

      allow update: if isAdmin() && isValidProfile(request.resource.data) && keepsItsOrigin() && keepsOwnAccess();
      // Employees are deactivated, never deleted.
      allow delete: if false;
    }

    // Orders (PRD, section 6.3). An order is created in progress and then only moves through the
    // transitions of the table: close, reopen, pay and cancel. Nobody changes a paid or cancelled order.
    match /Orders/{orderId} {
      function hasValidDestination(order) {
        return order.typeOrder in ['room', 'table', 'pool', 'bar', 'other']
          && (order.typeOrderNumber == null || (order.typeOrderNumber is int && order.typeOrderNumber > 0))
          // A room or a table is always a specific one.
          && (!(order.typeOrder in ['room', 'table']) || order.typeOrderNumber is int);
      }

      // RF-ORD-04: an order starts in progress, in the name of who takes it and with the server date.
      function isOwnNewOrder(order) {
        return order.id == orderId
          && order.idEmployee == request.auth.uid
          && order.state == 'in_progress'
          && hasValidDestination(order)
          && order.products is list
          && order.products.size() > 0
          && order.totalPayAmount is int
          && order.totalPayAmount >= 0
          && hasValidTaxAmount(order)
          && order.dateOrder == request.time;
      }

      // RF-INV-07: the tax is a part of the total, in whole pesos. Orders saved before M4 have none.
      function hasValidTaxAmount(order) {
        return !('taxAmount' in order)
          || (order.taxAmount is int && order.taxAmount >= 0 && order.taxAmount <= order.totalPayAmount);
      }

      function changesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function movesFrom(states, newState) {
        return resource.data.state in states && request.resource.data.state == newState;
      }

      // RF-ORD-05: confirming again rewrites the same order (same id), so its owner may overwrite it.
      function isRetryOfTheCreation() {
        return resource.data.idEmployee == request.auth.uid
          && resource.data.state == 'in_progress'
          && isOwnNewOrder(request.resource.data);
      }

      // RF-CUR-06 and RF-CUR-13: products and total only change while the order is in progress.
      // Adding lines does not touch the total (V6): closing the bill settles it.
      function isProductChange() {
        return movesFrom(['in_progress'], 'in_progress')
          && changesOnly(['products', 'totalPayAmount', 'taxAmount'])
          && hasValidTaxAmount(request.resource.data)
          && request.resource.data.products is list
          && request.resource.data.products.size() > 0
          && request.resource.data.totalPayAmount is int
          && request.resource.data.totalPayAmount >= 0;
      }

      // RF-CUR-04: closing settles the total from the lines, which cannot change afterwards.
      function isClosing() {
        return movesFrom(['in_progress'], 'closed')
          && changesOnly(['state', 'closedAt', 'closedBy', 'totalPayAmount', 'taxAmount'])
          && hasValidTaxAmount(request.resource.data)
          && request.resource.data.totalPayAmount is int
          && request.resource.data.totalPayAmount >= 0
          && request.resource.data.closedBy == request.auth.uid
          && request.resource.data.closedAt == request.time;
      }

      // RF-CUR-10
      function isReopening() {
        return movesFrom(['closed'], 'in_progress') && changesOnly(['state']);
      }

      // RF-CUR-05: the payment document must be created in the same transaction.
      function isPaying() {
        return movesFrom(['closed'], 'paid')
          && changesOnly(['state', 'paidAt', 'paidBy', 'paymentMethod', 'tipAmount'])
          && request.resource.data.paidBy == request.auth.uid
          && request.resource.data.paidAt == request.time
          && request.resource.data.paymentMethod in ['cash', 'transfer']
          && request.resource.data.tipAmount is int
          && request.resource.data.tipAmount >= 0
          && !exists(/databases/$(database)/documents/Payments/$('order_' + orderId))
          && existsAfter(/databases/$(database)/documents/Payments/$('order_' + orderId));
      }

      // RF-CUR-07: only an administrator cancels, and always with a reason.
      function isCancelling() {
        return isAdmin()
          && movesFrom(['in_progress', 'closed'], 'cancelled')
          && changesOnly(['state', 'cancelReason', 'cancelledAt', 'cancelledBy'])
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() > 0
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt == request.time;
      }

      allow read: if isActiveEmployee();
      allow create: if isActiveEmployee() && isOwnNewOrder(request.resource.data);
      allow update: if isActiveEmployee()
        && (isRetryOfTheCreation() || isProductChange() || isClosing() || isReopening() || isPaying() || isCancelling());
      // RNF-11: orders are cancelled, never deleted.
      allow delete: if false;

      // RF-CUR-11: the history. Each event is written once, by who made the change, with the server date.
      match /events/{eventId} {
        allow read: if isActiveEmployee();
        allow create: if isActiveEmployee()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.type in ['closed', 'reopened', 'paid', 'cancelled', 'products_added', 'products_removed'];
        allow update, delete: if false;
      }
    }

    // Payments received. The balance and the cash closing are built from these, so a payment is
    // created once and never edited or deleted. Only administrators read them (PRD, section 3).
    match /Payments/{paymentId} {
      function orderPath(payment) {
        return /databases/$(database)/documents/Orders/$(payment.sourceId);
      }

      // RF-CUR-05 and RF-CUR-08: one payment per order, for its whole amount, in the same transaction
      // that moves the order from closed to paid. The tip goes apart (P15).
      function isPaymentOfAnOrder(payment) {
        return payment.keys().hasAll(['amount', 'tipAmount', 'method', 'source', 'sourceId', 'receivedBy', 'receivedAt',
            'taxAmount', 'typeOrder', 'typeOrderNumber', 'products'])
          && payment.keys().hasOnly(['amount', 'tipAmount', 'method', 'source', 'sourceId', 'receivedBy', 'receivedAt',
            'taxAmount', 'typeOrder', 'typeOrderNumber', 'products'])
          && payment.source == 'order'
          && paymentId == 'order_' + payment.sourceId
          && payment.receivedBy == request.auth.uid
          && payment.receivedAt == request.time
          && payment.method in ['cash', 'transfer']
          && payment.tipAmount is int
          && payment.tipAmount >= 0
          && get(orderPath(payment)).data.state == 'closed'
          && getAfter(orderPath(payment)).data.state == 'paid'
          && payment.amount == get(orderPath(payment)).data.totalPayAmount
          && isCopyOfTheOrder(payment, get(orderPath(payment)).data);
      }

      // RF-BAL-02 and RF-BAL-03: the balance filters and breaks down by destination, tax and product
      // reading only the payments, so the payment carries an exact copy of what the order had.
      function isCopyOfTheOrder(payment, order) {
        return payment.taxAmount == order.get('taxAmount', 0)
          && payment.typeOrder == order.typeOrder
          && payment.typeOrderNumber == order.get('typeOrderNumber', null)
          && payment.products == order.products;
      }

      allow read: if isAdmin();
      allow create: if isActiveEmployee() && isPaymentOfAnOrder(request.resource.data);
      allow update, delete: if false;
    }

    // RF-BAL-06: cash closings. Only an administrator reads or creates them, and they are never
    // edited or deleted. The id is the number of the closing: 1, 2, 3… Since only a document that
    // does not exist can be created, and each one must follow the one before, two closings can
    // never cover the same payments.
    match /CashClosings/{closingId} {
      function closingPath(number) {
        return /databases/$(database)/documents/CashClosings/$(string(number));
      }

      // The first closing covers every earlier payment; the others start where the one before ended.
      function followsTheLastClosing(closing) {
        return string(int(closingId)) == closingId
          && ((int(closingId) == 1 && closing.from == null)
            || (int(closingId) > 1
              && exists(closingPath(int(closingId) - 1))
              && closing.from == get(closingPath(int(closingId) - 1)).data.to));
      }

      // The rules cannot add up the payments, so the expected cash is the one the app computed.
      // O3: a difference is either $0 or justified in the note.
      function isValidClosing(closing) {
        return closing.keys().hasAll(['from', 'to', 'type', 'expectedCash', 'countedCash', 'difference', 'note', 'closedBy', 'createdAt'])
          && closing.keys().hasOnly(['from', 'to', 'type', 'expectedCash', 'countedCash', 'difference', 'note', 'closedBy', 'createdAt'])
          && closing.type in ['daily', 'manual']
          && closing.expectedCash is int
          && closing.expectedCash >= 0
          && closing.countedCash is int
          && closing.countedCash >= 0
          && closing.difference is int
          && closing.difference == closing.countedCash - closing.expectedCash
          && closing.note is string
          && closing.note.size() <= 500
          && (closing.difference == 0 || closing.note.size() > 0)
          && closing.closedBy == request.auth.uid
          && closing.createdAt == request.time
          && (closing.to == null || (closing.to is timestamp && closing.to <= request.time))
          && (closing.from == null || (closing.from is timestamp && closing.to != null && closing.to >= closing.from));
      }

      allow read: if isAdmin();
      allow create: if isAdmin() && isValidClosing(request.resource.data) && followsTheLastClosing(request.resource.data);
      allow update, delete: if false;
    }

    // Inventory (PRD, section 6.4). Every active employee reads it, to take orders; only an
    // administrator changes it.
    match /Categories/{categoryId} {
      function isValidCategory(category) {
        return category.keys().hasOnly(['name', 'position'])
          && category.name is string
          && category.name.size() > 0
          && category.position is int
          && category.position >= 0;
      }

      allow read: if isActiveEmployee();
      allow create, update: if isAdmin() && isValidCategory(request.resource.data);
      // The app only deletes a category that has no products (RF-INV-04).
      allow delete: if isAdmin();
    }

    // RF-INV-07: optional taxes. The rate is a whole number of hundredths of a point: 19 % is 1900.
    match /Taxes/{taxId} {
      function isValidTax(tax) {
        return tax.keys().hasOnly(['name', 'rate', 'active'])
          && tax.name is string
          && tax.name.size() > 0
          && tax.rate is int
          && tax.rate > 0
          && tax.rate <= 10000
          && tax.active is bool;
      }

      allow read: if isActiveEmployee();
      allow create, update: if isAdmin() && isValidTax(request.resource.data);
      // A tax is deactivated, never deleted: products may still point to it.
      allow delete: if false;
    }

    match /Products/{productId} {
      // RF-INV-02: a name and a price greater than zero, in whole pesos.
      function isValidProduct(product) {
        return product.keys().hasOnly(['name', 'unitPrice', 'categoryId', 'taxId', 'active'])
          && product.name is string
          && product.name.size() > 0
          && product.unitPrice is int
          && product.unitPrice > 0
          && product.categoryId is string
          && product.categoryId.size() > 0
          && (product.taxId == null || product.taxId is string)
          && product.active is bool;
      }

      allow read: if isActiveEmployee();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      // RF-INV-03: a product is deactivated, never deleted, so the history keeps it.
      allow delete: if false;
    }

    // RF-ASI-01 and RF-ASI-02 (M8).
    match /Shifts/{shiftId} {
      function isValidShift(shift) {
        return shift.keys().hasAll(['employeeId', 'startAt', 'endAt', 'createdBy'])
          && shift.keys().hasOnly(['employeeId', 'startAt', 'endAt', 'area', 'createdBy'])
          && shift.employeeId is string
          && shift.startAt is timestamp
          && shift.endAt is timestamp
          && shift.endAt > shift.startAt
          // A shift may cross midnight, but it lasts less than a day.
          && shift.endAt <= shift.startAt + duration.value(24, 'h')
          && (!('area' in shift) || shift.area == null || shift.area in ['service', 'reception', 'housekeeping', 'maintenance', 'management'])
          && shift.createdBy == request.auth.uid;
      }

      // Each employee reads only their own shifts, so the app asks for them by employeeId.
      allow read: if isAdmin() || (isActiveEmployee() && resource.data.employeeId == request.auth.uid);
      allow create, update: if isAdmin() && isValidShift(request.resource.data);
      // A shift is a plan, not a record: it is deleted, unlike the attendance markings.
      allow delete: if isAdmin();
    }

    // RF-ASI-03 to RF-ASI-11 (M8): an entry and, later, its exit. Each mark keeps the time of the
    // server and the one of the device; from a phone, the distance to the hotel and the accuracy,
    // never the coordinates (RF-ASI-10); at reception, the authorized computer. The rules cannot
    // check where a phone is (R12): the app does, and the administrator reviews and corrects.
    match /Attendance/{attendanceId} {
      function isAuthorizedComputer(deviceId) {
        return get(/databases/$(database)/documents/Devices/$(deviceId)).data.active == true;
      }

      function isValidMark(source, deviceId, distance, accuracy) {
        return (source == 'phone' && deviceId == null
            && distance is int && distance >= 0 && accuracy is int && accuracy >= 0)
          || (source == 'kiosk' && deviceId is string && distance == null && accuracy == null
            && isAuthorizedComputer(deviceId));
      }

      function hasNoExit(record) {
        return record.get('clockOutAt', null) == null
          && record.get('clockOutDeviceTime', null) == null
          && record.get('clockOutSource', null) == null
          && record.get('clockOutDeviceId', null) == null
          && record.get('clockOutDistanceMeters', null) == null
          && record.get('clockOutAccuracyMeters', null) == null;
      }

      // An employee marks their own entry, with the time of the server: a mark made without
      // connection gets it when it reaches the server (RF-ASI-05).
      function isOwnEntry(entry) {
        return entry.keys().hasAll(['employeeId', 'clockInAt', 'clockInDeviceTime', 'clockInSource'])
          && entry.keys().hasOnly(['employeeId', 'clockInAt', 'clockInDeviceTime', 'clockInSource', 'clockInDeviceId',
            'clockInDistanceMeters', 'clockInAccuracyMeters', 'clockOutAt', 'clockOutDeviceTime', 'clockOutSource',
            'clockOutDeviceId', 'clockOutDistanceMeters', 'clockOutAccuracyMeters'])
          && entry.employeeId == request.auth.uid
          && entry.clockInAt == request.time
          && entry.clockInDeviceTime is timestamp
          && isValidMark(entry.clockInSource, entry.get('clockInDeviceId', null),
            entry.get('clockInDistanceMeters', null), entry.get('clockInAccuracyMeters', null))
          && hasNoExit(entry);
      }

      // The exit closes the entry once, and changes nothing else (RF-ASI-04).
      function isOwnExit() {
        let exit = request.resource.data;
        return resource.data.employeeId == request.auth.uid
          && hasNoExit(resource.data)
          && exit.diff(resource.data).affectedKeys().hasOnly(['clockOutAt', 'clockOutDeviceTime', 'clockOutSource',
            'clockOutDeviceId', 'clockOutDistanceMeters', 'clockOutAccuracyMeters'])
          && exit.clockOutAt == request.time
          && exit.clockOutDeviceTime is timestamp
          && isValidMark(exit.clockOutSource, exit.get('clockOutDeviceId', null),
            exit.get('clockOutDistanceMeters', null), exit.get('clockOutAccuracyMeters', null));
      }

      // RF-ASI-09: reception sees who has an entry without exit, and nothing else of the marks.
      function isReceptionist() {
        return isActiveEmployee() && get(profilePath()).data.type == 'reception';
      }

      function hasReason(correction) {
        return correction.get('reason', null) is string && correction.reason.size() > 0 && correction.reason.size() <= 200;
      }

      // RF-ASI-07: a correction says who made it, with the time of the server. The time of the
      // device or the one of the server is chosen as it is; any other time comes with a reason.
      // [record] is the record before the correction; `mark` is clockIn or clockOut.
      function isValidCorrection(correction, record) {
        return correction.keys().hasAll(['kind', 'mark', 'time', 'by', 'at'])
          && correction.keys().hasOnly(['kind', 'mark', 'time', 'reason', 'by', 'at'])
          && correction.by == request.auth.uid
          && correction.at == request.time
          && correction.mark in ['clockIn', 'clockOut']
          && correction.time is timestamp
          && correction.time <= request.time
          && ((correction.kind == 'device' && correction.time == record.get(correction.mark + 'DeviceTime', null) && correction.get('reason', null) == null)
            || (correction.kind == 'server' && correction.time == record.get(correction.mark + 'At', null) && correction.get('reason', null) == null)
            || (correction.kind == 'other' && hasReason(correction)));
      }

      // One correction at a time, under a new id named in lastCorrectionId; the ones before never change.
      function addsOneCorrection() {
        let before = resource.data.get('corrections', {});
        let after = request.resource.data.get('corrections', null);
        let id = request.resource.data.get('lastCorrectionId', null);
        return after is map
          && id is string
          && !(id in before)
          && after.diff(before).affectedKeys().hasOnly([id])
          && isValidCorrection(after[id], resource.data);
      }

      // The time that counts for a mark that exists. The mark itself keeps its original values.
      function isTimeCorrection() {
        let correction = request.resource.data.corrections[request.resource.data.lastCorrectionId];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['corrections', 'lastCorrectionId'])
          && resource.data.get(correction.mark + 'DeviceTime', null) != null;
      }

      // RF-ASI-06: the exit of a forgotten entry, written by the administrator with the time they give.
      function isMissingExit() {
        let exit = request.resource.data;
        let correction = exit.corrections[exit.lastCorrectionId];
        return hasNoExit(resource.data)
          && exit.diff(resource.data).affectedKeys().hasOnly(['corrections', 'lastCorrectionId', 'clockOutAt', 'clockOutDeviceTime', 'clockOutSource'])
          && correction.kind == 'other'
          && correction.mark == 'clockOut'
          && exit.clockOutSource == 'admin'
          && exit.clockOutAt == correction.time
          && exit.clockOutDeviceTime == correction.time;
      }

      function isCorrection() {
        return isAdmin() && addsOneCorrection() && (isTimeCorrection() || isMissingExit());
      }

      function hasNoPlace(record, mark) {
        return record.get(mark + 'DeviceId', null) == null
          && record.get(mark + 'DistanceMeters', null) == null
          && record.get(mark + 'AccuracyMeters', null) == null;
      }

      function isValidRegistration(correction) {
        return correction.keys().hasAll(['kind', 'reason', 'by', 'at'])
          && correction.keys().hasOnly(['kind', 'mark', 'time', 'reason', 'by', 'at'])
          && correction.kind == 'registration'
          && correction.get('mark', null) == null
          && correction.get('time', null) == null
          && hasReason(correction)
          && correction.by == request.auth.uid
          && correction.at == request.time;
      }

      // RF-ASI-07 with decision 4A: a shift that ended without marks gets them from the
      // administrator, with a reason. Both marks say so, with the times they gave, in the past and
      // less than a day apart, as a shift.
      function isRegistration(record) {
        let id = record.get('lastCorrectionId', null);
        return isAdmin()
          && record.keys().hasAll(['employeeId', 'clockInAt', 'clockInDeviceTime', 'clockInSource', 'clockOutAt', 'clockOutDeviceTime',
            'clockOutSource', 'corrections', 'lastCorrectionId'])
          && record.keys().hasOnly(['employeeId', 'clockInAt', 'clockInDeviceTime', 'clockInSource', 'clockInDeviceId',
            'clockInDistanceMeters', 'clockInAccuracyMeters', 'clockOutAt', 'clockOutDeviceTime', 'clockOutSource',
            'clockOutDeviceId', 'clockOutDistanceMeters', 'clockOutAccuracyMeters', 'corrections', 'lastCorrectionId'])
          && exists(/databases/$(database)/documents/Users/$(record.employeeId))
          && record.clockInSource == 'admin'
          && record.clockOutSource == 'admin'
          && record.clockInAt is timestamp
          && record.clockInDeviceTime == record.clockInAt
          && record.clockOutAt is timestamp
          && record.clockOutDeviceTime == record.clockOutAt
          && record.clockInAt < record.clockOutAt
          && record.clockOutAt <= request.time
          && record.clockOutAt <= record.clockInAt + duration.value(24, 'h')
          && hasNoPlace(record, 'clockIn')
          && hasNoPlace(record, 'clockOut')
          && id is string
          && record.corrections is map
          && record.corrections.keys().hasOnly([id])
          && id in record.corrections
          && isValidRegistration(record.corrections[id]);
      }

      // Each employee asks only for their own marks, by employeeId; reception asks for the open
      // ones of everybody (RF-ASI-09), and the administrator for the period of the report (RF-ASI-08).
      allow read: if isAdmin()
        || (isActiveEmployee() && resource.data.employeeId == request.auth.uid)
        || (isReceptionist() && resource.data.clockOutAt == null);
      allow create: if isActiveEmployee() && (isOwnEntry(request.resource.data) || isRegistration(request.resource.data));
      allow update: if isActiveEmployee() && (isOwnExit() || isCorrection());
      // A mark is never deleted: the administrator corrects it with a reason (RF-ASI-07).
      allow delete: if false;
    }

    // RF-ASI-11 (M8): the computers of reception where the employees mark with their account.
    match /Devices/{deviceId} {
      function isValidAuthorization(device) {
        return device.keys().hasAll(['name', 'authorizedBy', 'authorizedAt', 'active'])
          && device.keys().hasOnly(['name', 'authorizedBy', 'authorizedAt', 'active'])
          && device.name is string
          && device.name.size() > 0
          && device.name.size() <= 40
          && device.authorizedBy == request.auth.uid
          && device.authorizedAt == request.time
          && device.active == true;
      }

      // A revoked computer stays, so the marks made on it still say where they came from.
      function isRevocation() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active == false;
      }

      // A computer reads its own document, by its random id; only an administrator lists them all.
      allow get: if isActiveEmployee();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidAuthorization(request.resource.data);
      allow update: if isAdmin() && (isValidAuthorization(request.resource.data) || isRevocation());
      allow delete: if false;
    }

    // RF-EMP-06: the parameters of the hotel. Every active employee reads them, because they
    // decide how each device groups the sales by day and where attendance is marked; only an
    // administrator changes them, and every change says who made it and when.
    match /Settings/{settingsId} {
      // The parameters of each phase are optional, so a document saved before them is still valid.
      function isValidHotelSettings(settings) {
        return settings.keys().hasOnly(['operationalDayStartMinutes', 'lateToleranceMinutes', 'maxOpenEntryHours',
            'hotelLatitude', 'hotelLongitude', 'zoneRadiusMeters', 'minAccuracyMeters', 'updatedBy', 'updatedAt'])
          && settings.operationalDayStartMinutes is int
          && settings.operationalDayStartMinutes >= 0
          && settings.operationalDayStartMinutes < 1440
          && (!('lateToleranceMinutes' in settings) || (settings.lateToleranceMinutes is int && settings.lateToleranceMinutes >= 0 && settings.lateToleranceMinutes <= 120))
          && (!('maxOpenEntryHours' in settings) || (settings.maxOpenEntryHours is int && settings.maxOpenEntryHours >= 1 && settings.maxOpenEntryHours <= 24))
          // RF-ASI-10: the location of the hotel, never of an employee. Null until it is set.
          && (settings.get('hotelLatitude', null) == null || (settings.hotelLatitude is number && settings.hotelLatitude >= -90 && settings.hotelLatitude <= 90))
          && (settings.get('hotelLongitude', null) == null || (settings.hotelLongitude is number && settings.hotelLongitude >= -180 && settings.hotelLongitude <= 180))
          && (!('zoneRadiusMeters' in settings) || (settings.zoneRadiusMeters is int && settings.zoneRadiusMeters >= 20 && settings.zoneRadiusMeters <= 2000))
          && (!('minAccuracyMeters' in settings) || (settings.minAccuracyMeters is int && settings.minAccuracyMeters >= 10 && settings.minAccuracyMeters <= 500))
          && settings.updatedBy == request.auth.uid
          && settings.updatedAt == request.time;
      }

      allow read: if isActiveEmployee();
      allow create, update: if isAdmin() && settingsId == 'hotel' && isValidHotelSettings(request.resource.data);
      allow delete: if false;
    }
  }
}
