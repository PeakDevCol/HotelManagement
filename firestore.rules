rules_version = '2';

// Firestore security rules (PRD, section 8 and S3). A person publishes them; nothing here deploys itself.
// Anything without a match below is denied. Each milestone adds the rules of its own collections.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/Users/$(request.auth.uid);
    }

    // RF-AUTH-07: an account created outside the app has no profile, so it reads and writes nothing.
    // Spark has no custom claims, so the role comes from the profile. Each check costs one read.
    function isActiveEmployee() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    function isAdmin() {
      return isActiveEmployee() && get(profilePath()).data.type == 'admin';
    }

    function isValidProfile(profile) {
      return profile.keys().hasAll(['fullName', 'email', 'type', 'area', 'active'])
        && profile.keys().hasOnly(['fullName', 'email', 'type', 'area', 'active', 'createdAt', 'createdBy'])
        && profile.fullName is string
        && profile.email is string
        && profile.type in ['basic', 'reception', 'admin']
        && profile.area in ['service', 'reception', 'housekeeping', 'maintenance', 'management']
        && profile.active is bool;
    }

    match /Users/{userId} {
      // Everyone reads their own profile, even when inactive: the app needs it to explain why it denies access.
      allow get: if signedIn() && (request.auth.uid == userId || isActiveEmployee());
      allow list: if isActiveEmployee();
      // The allowed keys leave no room for password fields.
      allow create, update: if isAdmin() && isValidProfile(request.resource.data);
      // Employees are deactivated, never deleted.
      allow delete: if false;
    }

    // Orders (PRD, section 6.3). An order is created in progress and then only moves through the
    // transitions of the table: close, reopen, pay and cancel. Nobody changes a paid or cancelled order.
    match /Orders/{orderId} {
      function hasValidDestination(order) {
        return order.typeOrder in ['room', 'table', 'pool', 'bar', 'other']
          && (order.typeOrderNumber == null || (order.typeOrderNumber is int && order.typeOrderNumber > 0))
          // A room or a table is always a specific one.
          && (!(order.typeOrder in ['room', 'table']) || order.typeOrderNumber is int);
      }

      // RF-ORD-04: an order starts in progress, in the name of who takes it and with the server date.
      function isOwnNewOrder(order) {
        return order.id == orderId
          && order.idEmployee == request.auth.uid
          && order.state == 'in_progress'
          && hasValidDestination(order)
          && order.products is list
          && order.products.size() > 0
          && order.totalPayAmount is int
          && order.totalPayAmount >= 0
          && hasValidTaxAmount(order)
          && order.dateOrder == request.time;
      }

      // RF-INV-07: the tax is a part of the total, in whole pesos. Orders saved before M4 have none.
      function hasValidTaxAmount(order) {
        return !('taxAmount' in order)
          || (order.taxAmount is int && order.taxAmount >= 0 && order.taxAmount <= order.totalPayAmount);
      }

      function changesOnly(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
      }

      function movesFrom(states, newState) {
        return resource.data.state in states && request.resource.data.state == newState;
      }

      // RF-ORD-05: confirming again rewrites the same order (same id), so its owner may overwrite it.
      function isRetryOfTheCreation() {
        return resource.data.idEmployee == request.auth.uid
          && resource.data.state == 'in_progress'
          && isOwnNewOrder(request.resource.data);
      }

      // RF-CUR-06 and RF-CUR-13: products and total only change while the order is in progress.
      // Adding lines does not touch the total (V6): closing the bill settles it.
      function isProductChange() {
        return movesFrom(['in_progress'], 'in_progress')
          && changesOnly(['products', 'totalPayAmount', 'taxAmount'])
          && hasValidTaxAmount(request.resource.data)
          && request.resource.data.products is list
          && request.resource.data.products.size() > 0
          && request.resource.data.totalPayAmount is int
          && request.resource.data.totalPayAmount >= 0;
      }

      // RF-CUR-04: closing settles the total from the lines, which cannot change afterwards.
      function isClosing() {
        return movesFrom(['in_progress'], 'closed')
          && changesOnly(['state', 'closedAt', 'closedBy', 'totalPayAmount', 'taxAmount'])
          && hasValidTaxAmount(request.resource.data)
          && request.resource.data.totalPayAmount is int
          && request.resource.data.totalPayAmount >= 0
          && request.resource.data.closedBy == request.auth.uid
          && request.resource.data.closedAt == request.time;
      }

      // RF-CUR-10
      function isReopening() {
        return movesFrom(['closed'], 'in_progress') && changesOnly(['state']);
      }

      // RF-CUR-05: the payment document must be created in the same transaction.
      function isPaying() {
        return movesFrom(['closed'], 'paid')
          && changesOnly(['state', 'paidAt', 'paidBy', 'paymentMethod', 'tipAmount'])
          && request.resource.data.paidBy == request.auth.uid
          && request.resource.data.paidAt == request.time
          && request.resource.data.paymentMethod in ['cash', 'transfer']
          && request.resource.data.tipAmount is int
          && request.resource.data.tipAmount >= 0
          && !exists(/databases/$(database)/documents/Payments/$('order_' + orderId))
          && existsAfter(/databases/$(database)/documents/Payments/$('order_' + orderId));
      }

      // RF-CUR-07: only an administrator cancels, and always with a reason.
      function isCancelling() {
        return isAdmin()
          && movesFrom(['in_progress', 'closed'], 'cancelled')
          && changesOnly(['state', 'cancelReason', 'cancelledAt', 'cancelledBy'])
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() > 0
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt == request.time;
      }

      allow read: if isActiveEmployee();
      allow create: if isActiveEmployee() && isOwnNewOrder(request.resource.data);
      allow update: if isActiveEmployee()
        && (isRetryOfTheCreation() || isProductChange() || isClosing() || isReopening() || isPaying() || isCancelling());
      // RNF-11: orders are cancelled, never deleted.
      allow delete: if false;

      // RF-CUR-11: the history. Each event is written once, by who made the change, with the server date.
      match /events/{eventId} {
        allow read: if isActiveEmployee();
        allow create: if isActiveEmployee()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.type in ['closed', 'reopened', 'paid', 'cancelled', 'products_added', 'products_removed'];
        allow update, delete: if false;
      }
    }

    // Payments received. The balance and the cash closing are built from these, so a payment is
    // created once and never edited or deleted. Only administrators read them (PRD, section 3).
    match /Payments/{paymentId} {
      function orderPath(payment) {
        return /databases/$(database)/documents/Orders/$(payment.sourceId);
      }

      // RF-CUR-05 and RF-CUR-08: one payment per order, for its whole amount, in the same transaction
      // that moves the order from closed to paid. The tip goes apart (P15).
      function isPaymentOfAnOrder(payment) {
        return payment.keys().hasOnly(['amount', 'tipAmount', 'method', 'source', 'sourceId', 'receivedBy', 'receivedAt'])
          && payment.source == 'order'
          && paymentId == 'order_' + payment.sourceId
          && payment.receivedBy == request.auth.uid
          && payment.receivedAt == request.time
          && payment.method in ['cash', 'transfer']
          && payment.tipAmount is int
          && payment.tipAmount >= 0
          && get(orderPath(payment)).data.state == 'closed'
          && getAfter(orderPath(payment)).data.state == 'paid'
          && payment.amount == get(orderPath(payment)).data.totalPayAmount;
      }

      allow read: if isAdmin();
      allow create: if isActiveEmployee() && isPaymentOfAnOrder(request.resource.data);
      allow update, delete: if false;
    }

    // Inventory (PRD, section 6.4). Every active employee reads it, to take orders; only an
    // administrator changes it.
    match /Categories/{categoryId} {
      function isValidCategory(category) {
        return category.keys().hasOnly(['name', 'position'])
          && category.name is string
          && category.name.size() > 0
          && category.position is int
          && category.position >= 0;
      }

      allow read: if isActiveEmployee();
      allow create, update: if isAdmin() && isValidCategory(request.resource.data);
      // The app only deletes a category that has no products (RF-INV-04).
      allow delete: if isAdmin();
    }

    // RF-INV-07: optional taxes. The rate is a whole number of hundredths of a point: 19 % is 1900.
    match /Taxes/{taxId} {
      function isValidTax(tax) {
        return tax.keys().hasOnly(['name', 'rate', 'active'])
          && tax.name is string
          && tax.name.size() > 0
          && tax.rate is int
          && tax.rate > 0
          && tax.rate <= 10000
          && tax.active is bool;
      }

      allow read: if isActiveEmployee();
      allow create, update: if isAdmin() && isValidTax(request.resource.data);
      // A tax is deactivated, never deleted: products may still point to it.
      allow delete: if false;
    }

    match /Products/{productId} {
      // RF-INV-02: a name and a price greater than zero, in whole pesos.
      function isValidProduct(product) {
        return product.keys().hasOnly(['name', 'unitPrice', 'categoryId', 'taxId', 'active'])
          && product.name is string
          && product.name.size() > 0
          && product.unitPrice is int
          && product.unitPrice > 0
          && product.categoryId is string
          && product.categoryId.size() > 0
          && (product.taxId == null || product.taxId is string)
          && product.active is bool;
      }

      allow read: if isActiveEmployee();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      // RF-INV-03: a product is deactivated, never deleted, so the history keeps it.
      allow delete: if false;
    }
  }
}
